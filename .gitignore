# =========================
# Root .gitignore
# For MERN project with:
# /backend
# /frontend
# =========================

# Node modules
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment files
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build folders
dist/
build/
frontend/build/
backend/build/

# Cache folders
.cache/
.parcel-cache/
.next/
coverage/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Temporary files
*.tmp
*.temp

# Package lock optional (remove if you want to track it)
# package-lock.json
# yarn.lock